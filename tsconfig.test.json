{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-build"]
}
